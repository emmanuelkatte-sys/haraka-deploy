'use strict';

// Align Haraka SMTP ingest with PMTA <source 0/0>:
//   remove-received-headers true
//   add-received-header false
//   retain-x-virtual-mta no / retain-x-job no
//   remove-header leak list
// Runs before dkim so the signature covers the stripped header set.

const STRIP = [
    'x-virtual-mta',
    'X-Virtual-MTA',
    'x-job',
    'X-Job',
    'Return-Path',
    'X-Originating-IP',
    'X-PHP-Script',
    'X-PHP-Originating-Script',
    'User-Agent',
    'X-MSMail-Priority',
    'X-MimeOLE',
    'X-Sender',
    'X-AntiAbuse',
    'X-Source',
    'X-Source-Args',
    'X-Source-Dir',
    'X-Haraka',
    'X-Haraka-UUID',
    'X-Haraka-Transaction',
];

function strip (txn) {
    if (!txn) return;
    for (const name of STRIP) {
        try {
            txn.remove_header(name);
        }
        catch (e) {
            // keep going; header may be absent
        }
    }
}

exports.hook_data_post = function (next, connection) {
    try {
        strip(connection && connection.transaction);
    }
    catch (err) {
        if (this && typeof this.logerror === 'function') {
            this.logerror(`pmta_header_align skipped: ${err.message}`);
        }
    }
    return next();
};
