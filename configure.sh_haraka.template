'use strict';

// PowerMTA-compatible VERP: rewrite outbound MAIL FROM to
//   {local}-{encoded-recipient}@{domain}
// Encoding matches PMTA verp-default: '@' -> '=', other non [0-9A-Za-z.] -> +HH.

const { Address } = require('address-rfc2821');

function encodeRecipient (addr) {
    let out = '';
    for (const ch of addr) {
        if (ch === '@') {
            out += '=';
        }
        else if (/[0-9A-Za-z.]/.test(ch)) {
            out += ch;
        }
        else {
            const hex = ch.charCodeAt(0).toString(16).toUpperCase();
            out += `+${hex.length < 2 ? `0${hex}` : hex}`;
        }
    }
    return out;
}

function alreadyVerp (user) {
    return typeof user === 'string' && user.includes('=');
}

function applyVerp (plugin, connection) {
    const txn = connection && connection.transaction;
    if (!txn || !txn.mail_from || !txn.rcpt_to || !txn.rcpt_to.length) return;

    const from = txn.mail_from;
    if (!from.user || !from.host) return;
    if (alreadyVerp(from.user)) return;

    const rcpt = txn.rcpt_to[0];
    const rcptAddr = typeof rcpt.address === 'function' ? rcpt.address() : String(rcpt);
    if (!rcptAddr || rcptAddr === '<>') return;

    const verpLocal = `${from.user}-${encodeRecipient(rcptAddr)}`;
    txn.mail_from = new Address(`<${verpLocal}@${from.host}>`);
    if (plugin && typeof plugin.loginfo === 'function') {
        plugin.loginfo(`VERP MAIL FROM -> ${txn.mail_from.address()}`);
    }
}

exports.hook_queue_outbound = function (next, connection) {
    try {
        applyVerp(this, connection);
    }
    catch (err) {
        if (this && typeof this.logerror === 'function') {
            this.logerror(`VERP rewrite skipped: ${err.message}`);
        }
    }
    return next();
};

exports.hook_pre_send_trans_email = function (next, connection) {
    try {
        applyVerp(this, connection);
    }
    catch (err) {
        if (this && typeof this.logerror === 'function') {
            this.logerror(`VERP rewrite skipped: ${err.message}`);
        }
    }
    return next();
};
JSEOF
