from pathlib import Path
import re
import sys

overlay = Path("/tmp/dkim-sign-stream.js").read_text(encoding="utf-8")
NEW = """exports.get_headers_to_sign = function () {
  if (!this.cfg?.sign?.headers) return ['From']

  const headers = this.cfg.sign.headers
    .replace(/\\s+/g, '')
    .split(/[,;:]/)
    .filter(Boolean)

  if (!headers.some((h) => h.toLowerCase() === 'from')) headers.push('From')

  return headers
}"""
hdr_pat = re.compile(r"exports\.get_headers_to_sign = function\s*\(\)\s*\{.*?\n\}", re.S)
wrote = 0
rewired = 0
hdr_n = 0
for root in (Path("/root/haraka"), Path("/usr/lib"), Path("/usr/local/lib")):
    if not root.exists():
        continue
    for dkim_js in root.rglob("dkim.js"):
        p = str(dkim_js).replace("\\", "/")
        if "haraka-plugin-dkim" not in p or "/lib/" not in p:
            continue
        dest = dkim_js.parent / "dkim-sign-stream.js"
        dest.write_text(overlay, encoding="utf-8")
        wrote += 1
        print(f"installed DKIM stream {dest}")
        text = dkim_js.read_text(encoding="utf-8")
        if "dkim-sign-stream" not in text:
            new, n = re.subn(
                r"exports\.DKIMSignStream\s*=\s*DKIMSignStream",
                "exports.DKIMSignStream = require('./dkim-sign-stream')",
                text,
                count=1,
            )
            if n:
                dkim_js.write_text(new, encoding="utf-8")
                rewired += 1
                print(f"rewired DKIMSignStream export {dkim_js}")
            else:
                print(f"WARN: could not rewire {dkim_js}")
    for path in root.rglob("index.js"):
        if "haraka-plugin-dkim" not in str(path).replace("\\", "/"):
            continue
        text = path.read_text(encoding="utf-8")
        new_text, c = hdr_pat.subn(lambda _: NEW, text, count=1)
        if c:
            path.write_text(new_text, encoding="utf-8")
