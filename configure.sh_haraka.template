'use strict';

const os = require('os');
const utils = require('haraka-utils');

function isLoopback (ip) {
    if (!ip) return true;
    const s = String(ip).toLowerCase();
    return s === '127.0.0.1' || s === '::1' || s === '::ffff:127.0.0.1' || s === 'localhost';
}

function byHost (plugin, connection) {
    let me = '';
    try {
        me = String(plugin.config.get('me') || '').trim();
    } catch (e) {
        me = '';
    }
    if (me) return me;
    const from = connection.transaction && connection.transaction.mail_from;
    if (from && from.host) return String(from.host);
    return os.hostname() || 'localhost';
}

function heloHost (connection, fallback) {
    const h = connection.hello && connection.hello.host;
    if (!h) return fallback;
    const s = String(h).trim();
    if (!s || isLoopback(s) || s === '[127.0.0.1]') return fallback;
    return s;
}

function applyReceived (plugin, connection) {
    const txn = connection && connection.transaction;
    if (!txn) return;
    if (txn.notes && txn.notes.mta_received) return;

    const by = byHost(plugin, connection);
    const helo = heloHost(connection, by);
    const uuid = String((txn.uuid || '')).split('.')[0] || 'NOQUEUE';
    const proto = (connection.tls && connection.tls.enabled) ? 'ESMTPSA' : 'ESMTPA';

    let line = `from ${helo}`;
    const remote = connection.remote && connection.remote.ip;
    if (remote && !isLoopback(remote)) {
        line += ` ([${remote}])`;
    }
    line += ` by ${by} with ${proto} id ${uuid}`;
    if (txn.rcpt_to && txn.rcpt_to.length === 1) {
        const rcpt = typeof txn.rcpt_to[0].address === 'function'
            ? txn.rcpt_to[0].address()
            : String(txn.rcpt_to[0] || '');
        if (rcpt && rcpt !== '<>') {
            line += ` for <${rcpt}>`;
        }
    }
    line += `;\r\n\t${utils.date_to_str(new Date())}`;
    txn.add_leading_header('Received', line);
    if (txn.notes) txn.notes.mta_received = true;
}

exports.hook_data_post = function (next, connection) {
    try {
        applyReceived(this, connection);
    } catch (err) {
        if (this && typeof this.logerror === 'function') {
            this.logerror(`mta_received skipped: ${err.message}`);
        }
    }
    return next();
};
JSEOF
